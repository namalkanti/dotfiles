cmd dirsize %{{ 
  size=$(du -sh -- "$f" 2>/dev/null | cut -f1)
  lf -remote "send $id echo $size  $f"
}}

map D :dirsize

map Y $printf '%s' "$f" | xclip -selection clipboard

set previewer ~/.config/lf/preview.sh
map i $~/.config/lf/preview.sh "$f" | less -R

# Quit and cd
cmd quit-cd &{{
    [ -n "$LF_CD_FILE" ] && echo "$PWD" > "$LF_CD_FILE"
    lf -remote "send $id quit"
}}
map Q quit-cd

