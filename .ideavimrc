" IdeaVim config

" === Leader ===
let mapleader = " "

" === Plugins (IdeaVim native emulation) ===
set surround
set commentary
set argtextobj
set highlightedyank

" === Basic settings ===
set showcmd
set hlsearch
set incsearch
set ignorecase
set smartcase
set number
set timeout
set timeoutlen=1000

" === Jumplist ===
nnoremap gf <C-i>
nnoremap gb <C-o>

" === Line navigation: 0=first word, ^/_=beginning of line ===
nnoremap 0 ^
nnoremap ^ 0
nnoremap _ 0

" === Window navigation ===
nnoremap <c-j> <c-w>j
nnoremap <c-k> <c-w>k
nnoremap <c-h> <c-w>h
nnoremap <c-l> <c-w>l
nnoremap <c-c> <c-w>c
nnoremap <c-o> <c-w>o

" === Horizontal scrolling ===
nnoremap <silent> <Left> zh
nnoremap <silent> <Right> zl

" === File/search navigation (replaces FZF) ===
nmap <C-p> <Action>(GotoFile)
nmap <C-b> <Action>(Switcher)
nmap <C-i> <Action>(FindInPath)

" === LSP-equivalent IDE actions ===
nnoremap <silent> gd <Action>(GotoDeclaration)
nnoremap <silent> gr <Action>(FindUsages)
nnoremap <silent> K <Action>(ShowHoverInfo)
nnoremap <silent> <leader>e <Action>(ShowErrorDescription)
nnoremap <silent> <leader>rn <Action>(RenameElement)
nnoremap <silent> <leader>ca <Action>(ShowIntentionActions)
nnoremap <silent> <leader>f <Action>(ReformatCode)

" === Tests & Execution ===
nnoremap <leader>ta <Action>(GotoTest)
nnoremap <leader>tt <Action>(RunClass)
nnoremap <leader>tr <Action>(Run)
nnoremap <leader>td <Action>(Debug)
